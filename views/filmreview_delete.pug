extends layout

block content

  h1= title

  p #[strong Do you really want to delete this Review?]

  div(style="margin-left:20px")

    p #[strong ID]: #{filmreview._id}

    p #[strong Username:] #{filmreview.username}

    p #[strong Review: ] #{filmreview.filmreview}

  form(method='POST')
    div.form-group
      input#id.form-control(type='hidden',name='id', value=filmreview._id )

    button.btn.btn-primary(type='submit') Delete